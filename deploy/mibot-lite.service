# Installed as /etc/systemd/system/mibot-lite.service by
# scripts/install-service.sh. Placeholders are substituted by that script.
[Unit]
Description=MiBot Lite
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart=@BINARY@ --serve --root @ROOT@

# Hardening. A single static Go binary with no JIT can take the strictest
# options, each enabled here for a reason worth recording:
#   MemoryDenyWriteExecute - nothing in this process maps writable
#                            executable memory. Node could not do this
#                            because V8 needs W+X for its JIT.
#   ProtectSystem=strict   - everything outside ReadWritePaths is read-only.
#                            The deployment directory stays writable because
#                            .update renames the new binary into it and the
#                            command data lives there.
#   PrivateTmp             - the process keeps nothing in /tmp; the instance
#                            lock is an flock inside the deployment root.
MemoryDenyWriteExecute=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=@ROOT@
# The deployment directory holds config.json (the Telegram session) and the
# command data, which includes API keys. Nothing here is world-readable.
UMask=0077
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

# A backstop against a leak, not a budget for the work.
#
# There was a MemoryHigh=128M here, and it was a mistake: MemoryHigh does
# not fail, it throttles, so a transient spike becomes a process crawling
# under constant reclaim instead of an error anyone can read. .eatgif
# encodes VP9 through ffmpeg, which wants well over 100M for a few seconds
# on top of the resident program, and it tripped that watermark 14613
# times in one run — the encode was still going when its own timeout
# killed it, leaving no output and no explanation.
#
# The resident process is ~25M, which is the number this project is about.
# What follows is headroom for a child that runs for seconds at a time,
# and a ceiling high enough that reaching it means something is actually
# wrong.
MemoryMax=512M

Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mibot-lite

[Install]
WantedBy=multi-user.target
